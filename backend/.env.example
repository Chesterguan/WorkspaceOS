DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pr_secretary
GITHUB_TOKEN=ghp_your_token_here
ACTIVE_AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514
API_SECRET_KEY=dev-secret-key
MAX_COMMITS_PER_SYNC=50

# Local model (Ollama) - set ACTIVE_AI_PROVIDER=ollama to use
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Twitter/X API credentials (OAuth 1.0a, required for auto-publishing tweets)
# Create an app at https://developer.twitter.com and enable "Read and Write" permissions.
# Generate an access token + secret under "Keys and Tokens" for your user account.
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_token_secret_here
